      "strength": "lowest migration risk",
      "weakness": "standalone stages reread the labeled checkpoint",
      "partitioning": "matched source shard_id; labeled global ordinal/shard range; date/slot secondary only"
    },
    "B": {
      "name": "Labeled stream fan-out",
      "flow": [
        "matched shards",
        "one external sort",
        "Python label state machine",
        "labeled Arrow RecordBatch",
        "Demand/Supply/TTE consumers and labeled checkpoint"
      ],
      "strength": "no service_labels table, no JOIN, one labeled traversal",
      "weakness": "Supply/TTE full algorithm integration and failure state need proof"
    },
    "C": {
      "name": "DuckDB/Arrow hybrid",
      "flow": [
        "Parquet shards",
        "DuckDB external sort",
        "Arrow RecordBatch",
        "Python labeling",
        "partitioned labeled Parquet",
        "DuckDB/Arrow consumers"
      ],
      "safe_pushdown": [
        "typed projection",
        "null/time filters",
        "external sort",
        "Demand integer group aggregation"
      ],
      "must_remain_python": [
        "driver boundary",

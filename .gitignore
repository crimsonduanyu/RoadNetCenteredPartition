# Frozen reproducibility snapshot (large binary artifacts; keep local, do not commit).
# Only the README is tracked so the folder's purpose is documented in git.
IntermediateDataForReproduce/*
!IntermediateDataForReproduce/README.md

# Golden metadata is tracked; payload is local-only unless explicitly reviewed.
artifacts/golden/*/inputs/**
artifacts/golden/*/expected/**
artifacts/golden/*/legacy_comparisons/**

# Historical processed baselines are private/local-only; track metadata only.
artifacts/baselines/fifth-ring-windows-v1/payload/**


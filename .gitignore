# Runtime outputs
outputs/**

# Private/local data payloads
data/raw/**
data/interim/**
data/processed/**

# Keep reviewed documentation, schemas, and synthetic/sample data trackable.
!data/**/
!data/**/README.md
!data/**/manifest.json
!data/**/*.sha256
!data/**/schema*.json
!data/**/schema*.yaml
!data/**/schema*.yml
!data/**/synthetic/**
!data/**/sample/**
!data/**/samples/**

# Local-only artifact payloads
artifacts/baselines/**/payload/**
artifacts/golden/**/payload/**
artifacts/golden/**/inputs/**
artifacts/golden/**/expected/**
artifacts/golden/**/legacy_comparisons/**

# Keep artifact metadata and publication assets trackable.
!artifacts/**/
!artifacts/**/README.md
!artifacts/**/manifest.json
!artifacts/**/*.sha256
!artifacts/paper/**

# Python/build/cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments and local secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Local databases and logs
*.sqlite
*.sqlite3
*.db
*.log
*.pid

# Editor/local agent settings
.vscode/settings.json
.vscode/launch.json
.claude/settings.local.json
.idea/
*.swp
*.swo
.ipynb_checkpoints/

# OS and geospatial sidecars
.DS_Store
Thumbs.db
desktop.ini
*.gpkg-shm
*.gpkg-wal
*.qix
*.cpg
*.prj
*.sbn
*.sbx
*.shx

# Local caches
cache/
